{
  "name": "loop-recorder-domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-neutral domain layer for the Audio Loop Recorder. No runtime dependencies.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "node Tools/verify-timing.js && node Tools/verify-region.js",
    "check": "npm run typecheck && npm test && npm run verify",
    "build:ui": "tsc -p tsconfig.build.json",
    "ui": "npm run build:ui && node Tools/serve.js"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
